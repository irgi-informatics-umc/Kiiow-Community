---
import { siteData } from '../data/site';
---

<section id="platform" class="platforms-section" aria-labelledby="platforms-heading">
  <div class="container">
    
    <div class="platforms-header">
      <div class="section-tag">
        <span class="pixel-indicator">■</span>
        <span>03 // KANAL KREATIF & DUKUNGAN</span>
      </div>
      <h2 id="platforms-heading" class="section-title">
        Dukungan & Konten Streaming.
      </h2>
      <p class="section-subtitle">
        Tautan langsung ke kanal kreasi video dan platform dukungan langsung kiiow.
      </p>
    </div>

    <div class="platforms-grid">
      
      <!-- Primary Feature: SociaBuzz Support Hub -->
      <article class="platform-card platform-primary">
        <div class="platform-card-badge">DUKUNGAN UTAMA</div>
        <div class="platform-body">
          <div class="platform-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>

          <div class="platform-meta">
            <span class="platform-service">SociaBuzz</span>
            <span class="platform-handle">sociabuzz.com/{siteData.sociabuzzHandle}</span>
          </div>

          <p class="platform-desc">
            Kanal dukungan resmi untuk menyemangati kiiow. Sekecil apa pun tip atau pesanmu, semuanya sangat berharga untuk menemani perjalanan stream mandiri ini.
          </p>

          <a
            href={siteData.primarySupportUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary platform-btn"
          >
            <span>Buka SociaBuzz</span>
            <span class="arrow-icon" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

      <!-- TikTok Streaming & Clips -->
      <article class="platform-card platform-secondary">
        <div class="platform-card-badge alt">KONTEN STREAMING</div>
        <div class="platform-body">
          <div class="platform-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.06-.081a2.895 2.895 0 0 1 2.366-4.554c.4 0 .783.08 1.13.226V9.453a6.335 6.335 0 0 0-1.13-.102c-3.535 0-6.4 2.865-6.4 6.4 0 3.536 2.865 6.4 6.4 6.4 3.536 0 6.4-2.864 6.4-6.4V9.018a8.163 8.163 0 0 0 4.71 1.488V7.06a4.793 4.793 0 0 1-1-.374z"/>
            </svg>
          </div>

          <div class="platform-meta">
            <span class="platform-service">TikTok</span>
            <span class="platform-handle">{siteData.tiktokHandle}</span>
          </div>

          <p class="platform-desc">
            Tempat kiiow berbagi cuplikan Minecraft, stream santai, dan berinteraksi langsung di komentar. Profil bernuansa bersih dengan estetika full white.
          </p>

          <a
            href={siteData.tiktokUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary platform-btn"
          >
            <span>Kunjungi TikTok</span>
            <span class="arrow-icon" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

    </div>

    <!-- Transparent Placeholder Notice: Degrades Gracefully -->
    <div class="placeholders-notice">
      <div class="notice-title">
        <span class="pixel-dot-warn"></span>
        <span>STATUS KOMUNITAS & JADWAL (CATATAN TRANSPARANSI)</span>
      </div>
      <p class="notice-desc">
        Kiiow mengedepankan kejujuran. Saat ini belum ada server Discord publik, IP server bersama terbuka, atau jadwal siaran kaku. Semua pengumuman interaktif dipusatkan melalui KII0W Community Channel resmi di WhatsApp.
      </p>
      <div class="placeholder-tags">
        <span class="ph-tag">JADWAL LIVE: MENYESUAIKAN WAKTU</span>
        <span class="ph-tag">DISCORD: BELUM DIBUKA</span>
        <span class="ph-tag">SERVER MC: SEGERA MENYUSUL</span>
      </div>
    </div>

  </div>
</section>

<style>
  .platforms-section {
    padding-block: var(--space-20);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface-deep);
  }

  .platforms-header {
    margin-bottom: var(--space-12);
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-lavender);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .pixel-indicator {
    color: var(--color-violet);
    font-size: 10px;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .section-subtitle {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .platform-card {
    position: relative;
    background-color: var(--color-bg);
    border: 2px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-bounce), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .platform-primary {
    border-color: var(--color-violet);
    box-shadow: 6px 6px 0 var(--color-surface-elevated);
  }

  .platform-primary:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--color-surface-highlight);
  }

  .platform-secondary {
    border-color: var(--color-border);
    box-shadow: 6px 6px 0 var(--color-surface-elevated);
  }

  .platform-secondary:hover {
    border-color: var(--color-white);
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--color-surface-highlight);
  }

  .platform-card-badge {
    position: absolute;
    top: -12px;
    left: var(--space-6);
    background: var(--color-violet);
    color: var(--color-black);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    letter-spacing: 0.06em;
  }

  .platform-card-badge.alt {
    background: var(--color-white);
    color: var(--color-black);
  }

  .platform-body {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .platform-icon-box {
    width: 48px;
    height: 48px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .platform-meta {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-4);
  }

  .platform-service {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-white);
  }

  .platform-handle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-lavender);
  }

  .platform-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    flex-grow: 1;
  }

  .platform-btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
  }

  .arrow-icon {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
  }

  /* Notice Card */
  .placeholders-notice {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
  }

  .notice-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-lavender);
    margin-bottom: var(--space-2);
  }

  .pixel-dot-warn {
    width: 8px;
    height: 8px;
    background-color: var(--color-violet);
  }

  .notice-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }

  .placeholder-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ph-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.25rem 0.6rem;
    background: var(--color-surface-deep);
    border: 1px dashed var(--color-border);
    color: var(--color-text-dim);
  }

  @media (max-width: 860px) {
    .platforms-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
