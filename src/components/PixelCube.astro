---
<svg
  class="pixel-cube-art"
  viewBox="0 0 160 160"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="Pixel art balok kiiow bergaya Minecraft editorial"
  role="img"
>
  <!-- Minecraft Isometric Pixel Cube (40x40 grid units rendered sharply) -->
  <!-- Top Face (Lavender/White highlights) -->
  <polygon points="80,20 136,52 80,84 24,52" fill="#C5B4FF" />
  <!-- Pixel stepping textures on top face -->
  <polygon points="80,20 96,29 80,38 64,29" fill="#FFFFFF" />
  <polygon points="104,33 120,42 104,51 88,42" fill="#E8E2FF" />
  <polygon points="48,38 64,47 48,56 32,47" fill="#A288E8" />
  <polygon points="80,56 96,65 80,74 64,65" fill="#9B7AFF" />

  <!-- Left Face (Deep Obsidian Violet Shadow) -->
  <polygon points="24,52 80,84 80,140 24,108" fill="#211D2A" />
  <!-- Left Face pixel details -->
  <polygon points="24,52 40,61 40,85 24,76" fill="#191620" />
  <polygon points="56,70 72,79 72,103 56,94" fill="#30293D" />
  <polygon points="40,97 56,106 56,122 40,113" fill="#111015" />

  <!-- Right Face (Mid-tone Obsidian Violet) -->
  <polygon points="80,84 136,52 136,108 80,140" fill="#3D334C" />
  <!-- Right face pixel details -->
  <polygon points="88,61 104,52 104,76 88,85" fill="#4D4160" />
  <polygon points="104,90 120,81 120,105 104,114" fill="#2B2436" />
  <polygon points="88,103 104,94 104,118 88,127" fill="#5E4E77" />

  <!-- Pixel eyes/creature face subtle Easter egg inside the block -->
  <rect x="52" y="80" width="8" height="8" fill="#FFFFFF" />
  <rect x="68" y="80" width="8" height="8" fill="#FFFFFF" />
  <rect x="54" y="82" width="4" height="4" fill="#111015" />
  <rect x="70" y="82" width="4" height="4" fill="#111015" />

  <!-- Pixel outer border definition -->
  <polyline points="80,20 136,52 136,108 80,140 24,108 24,52 80,20" stroke="#383141" stroke-width="2" stroke-linejoin="round" />
  <line x1="80" y1="84" x2="80" y2="140" stroke="#383141" stroke-width="2" />
  <line x1="80" y1="84" x2="136" y2="52" stroke="#383141" stroke-width="2" />
  <line x1="80" y1="84" x2="24" y2="52" stroke="#383141" stroke-width="2" />
</svg>

<style>
  .pixel-cube-art {
    width: 100%;
    max-width: 220px;
    height: auto;
    filter: drop-shadow(8px 8px 0px rgba(17, 16, 21, 0.8));
    image-rendering: pixelated;
  }
</style>

