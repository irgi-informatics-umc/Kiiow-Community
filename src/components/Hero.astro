---
import { siteData } from '../data/site';
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="container hero-layout">
    
    <!-- Left Column: Editorial Statement & Actions -->
    <div class="hero-content">
      <div class="hero-badge-wrap">
        <span class="hero-status-pill">
          <span class="status-indicator" aria-hidden="true"></span>
          <span class="status-text">ruang streamer kecil</span>
        </span>
        <span class="hero-bio-quote">"{siteData.bioVerbatim}"</span>
      </div>

      <h1 id="hero-heading" class="hero-title">
        Bermain, nongkrong, dan bertumbuh bareng <span class="highlight-white">{siteData.displayName}</span>.
      </h1>

      <p class="hero-description">
        Selamat datang di sudut digital kiiow. Bukan server raksasa, bukan studio korporat—hanya streamer kecil penyuka balok Minecraft yang ingin berbagi momen santai bersama teman-teman baru.
      </p>

      <div class="hero-actions">
        <a
          href={siteData.primarySupportUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span>Dukung di SociaBuzz</span>
        </a>

        <a
          href={siteData.kiiowCommunityChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-whatsapp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>{siteData.kiiowCommunityChannelCta}</span>
        </a>

        <a
          href={siteData.tiktokUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.06-.081a2.895 2.895 0 0 1 2.366-4.554c.4 0 .783.08 1.13.226V9.453a6.335 6.335 0 0 0-1.13-.102c-3.535 0-6.4 2.865-6.4 6.4 0 3.536 2.865 6.4 6.4 6.4 3.536 0 6.4-2.864 6.4-6.4V9.018a8.163 8.163 0 0 0 4.71 1.488V7.06a4.793 4.793 0 0 1-1-.374z"/>
          </svg>
          <span>TikTok {siteData.tiktokHandle}</span>
        </a>
      </div>

      <div class="hero-editorial-footer">
        <span class="mono-label">AESTHETIC NOTE</span>
        <span class="editorial-line"></span>
        <span class="mono-label-val">Clean Full-White Profile × Obsidian Pixel</span>
      </div>
    </div>

    <!-- Right Column: Crafted Pixel Visual Anchor with Minecraft Skin -->
    <div class="hero-visual">
      <div class="visual-card">
        <div class="visual-card-header">
          <span class="pixel-tag">BLOCK // 01</span>
          <span class="coord-tag">X: 80 · Y: 64 · Z: 20</span>
        </div>
        
        <div class="character-wrapper">
          <img
            src={siteData.characterSkinImage}
            alt="Karakter Minecraft skin kiiow"
            class="character-skin-img"
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="visual-card-footer">
          <div class="stat-item">
            <span class="stat-label">STATUS</span>
            <span class="stat-val highlight-green">● Santai & Hangout</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">FOCUS</span>
            <span class="stat-val">Minecraft Gameplay</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  /* Subtle background pixel grid pattern (crisp, not blurry) */
  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, var(--color-border-subtle) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-border-subtle) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.35;
    pointer-events: none;
  }

  .hero-layout {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-badge-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-surface-deep);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-lavender);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    background: var(--color-violet);
    box-shadow: 0 0 6px var(--color-violet);
  }

  .hero-bio-quote {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.08;
    margin-bottom: var(--space-6);
    letter-spacing: -0.03em;
  }

  .highlight-white {
    color: var(--color-white);
    background: linear-gradient(180deg, transparent 65%, var(--color-surface-highlight) 65%);
    padding-inline: 0.15em;
  }

  .hero-description {
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 54ch;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .btn-whatsapp {
    border-color: var(--color-border);
  }

  .btn-whatsapp svg {
    color: #25d366;
  }

  .btn-whatsapp:hover {
    border-color: #25d366;
    box-shadow: 6px 6px 0 rgba(37, 211, 102, 0.25);
  }

  .hero-editorial-footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .editorial-line {
    flex-grow: 1;
    height: 1px;
    background: var(--color-border-subtle);
  }

  .mono-label-val {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Right column visual card */
  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .visual-card {
    width: 100%;
    max-width: 420px;
    background: var(--color-surface-deep);
    border: 2px solid var(--color-border);
    box-shadow: 8px 8px 0 var(--color-surface-elevated);
    padding: var(--space-6);
  }

  .visual-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  .pixel-tag {
    color: var(--color-lavender);
    font-weight: 600;
  }

  .character-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: var(--space-6);
    min-height: 240px;
  }

  .character-skin-img {
    max-width: 220px;
    max-height: 240px;
    width: auto;
    height: auto;
    object-fit: contain;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.45)) drop-shadow(4px 4px 0px var(--color-surface-deep));
    transition: transform var(--transition-bounce);
  }

  .character-skin-img:hover {
    transform: translateY(-4px) scale(1.02);
  }

  .visual-card-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  .stat-val {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-main);
  }

  .highlight-green {
    color: #4ade80;
  }

  @media (max-width: 900px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero-visual {
      order: -1;
      justify-content: flex-start;
    }

    .visual-card {
      max-width: 100%;
    }
  }
</style>
