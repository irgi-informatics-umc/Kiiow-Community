---
import { siteData } from '../../data/site';
---

<div class="whatsapp-channel-card">
  <div class="wa-badge-row">
    <span class="pixel-pill-badge">
      <span class="wa-pulse-dot" aria-hidden="true"></span>
      <span>SALURAN KOMUNITAS UTAMA</span>
    </span>
    <span class="channel-handle">@kiiow</span>
  </div>

  <div class="wa-card-main">
    <div class="wa-icon-box" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </div>

    <div class="wa-content">
      <h3 class="wa-channel-title">{siteData.kiiowCommunityChannelName}</h3>
      <p class="wa-channel-desc">
        {siteData.kiiowCommunityChannelDescription}
      </p>

      <div class="wa-features">
        <div class="wa-feature-item">
          <span class="feature-dot">■</span>
          <span>Pengumuman Komunitas & Kegiatan Rutin</span>
        </div>
        <div class="wa-feature-item">
          <span class="feature-dot">■</span>
          <span>Update Informasi Terkini kiiow</span>
        </div>
      </div>
    </div>
  </div>

  <div class="wa-card-footer">
    <a
      href={siteData.kiiowCommunityChannelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-wa-action"
    >
      <span>{siteData.kiiowCommunityChannelCta}</span>
      <span class="btn-arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</div>

<style>
  .whatsapp-channel-card {
    background-color: var(--color-surface-deep);
    border: 2px solid var(--color-border);
    box-shadow: 6px 6px 0 var(--color-surface-elevated);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-8);
    position: relative;
    transition: transform var(--transition-bounce), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .whatsapp-channel-card:hover {
    border-color: #25d366;
    transform: translateY(-2px);
    box-shadow: 8px 8px 0 rgba(37, 211, 102, 0.15);
  }

  .wa-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--color-border);
    margin-bottom: var(--space-6);
  }

  .pixel-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #0f1c14;
    border: 1px solid #1c3b28;
    color: #4ade80;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
  }

  .wa-pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #25d366;
    box-shadow: 0 0 6px rgba(37, 211, 102, 0.7);
  }

  .channel-handle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-lavender);
    font-weight: 600;
  }

  .wa-card-main {
    display: flex;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .wa-icon-box {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    color: #25d366;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wa-content {
    display: flex;
    flex-direction: column;
  }

  .wa-channel-title {
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    color: var(--color-white);
    margin-bottom: var(--space-2);
  }

  .wa-channel-desc {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .wa-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wa-feature-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-lavender);
  }

  .feature-dot {
    color: #25d366;
    font-size: 8px;
  }

  .wa-card-footer {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-6);
  }

  .btn-wa-action {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-surface-elevated);
    color: var(--color-white);
    border: 2px solid var(--color-border);
    padding: 0.85rem 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: transform var(--transition-bounce), border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .btn-wa-action:hover {
    border-color: #25d366;
    background: #142119;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-arrow {
    font-size: var(--text-md);
  }

  @media (max-width: 640px) {
    .wa-card-main {
      flex-direction: column;
      gap: var(--space-4);
    }
    .wa-icon-box {
      width: 44px;
      height: 44px;
    }
  }
</style>
